{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "baseUrl": "..",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "types": ["node"],
        "allowJs": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts",
        "../playwright.config.ts",
        "../playwright.ios.config.ts",
        "../playwright.ios-explore.config.ts"
    ]
}
